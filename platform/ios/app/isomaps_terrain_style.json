      "source-layer": "coastlines",
      "paint": {
        "line-color": "#ffffff",
        "line-width": 0.5,
        "line-opacity": 0.7
      }
    },
    {
      "id": "peak",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "mountain_peak",
      "minzoom": 11.5,
      "layout": {
        "visibility": "none",
        "text-font": [
          "Noto Sans Italic"
        ],
        "icon-image": "mountain-11",
        "icon-size": 1,
        "text-size": 9,
        "text-field": "{name:latin}\n{ele}m",
        "symbol-spacing": 350,
        "text-max-width": 5,
        "text-letter-spacing": 0.2,
        "text-rotation-alignment": "map"
      },
      "filter": [
        "all",
        [
          "in",
          "class",
          "peak"
        ]
      ],
      "paint": {
        "text-translate-anchor": "map",
        "text-translate": [
          0,
          20
        ]
      }
    }
