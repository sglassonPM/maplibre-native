{
  "metadata": {
    "mapbox:autocomposite": false,
    "openmaptiles:version": "3.x"
  },
  "layers": [
    {
      "id": "bg-test",
      "type": "background",
      "paint": {
        "background-color": "#b8c7d6"
      }
    },
    {
      "id": "satellite-raster",
      "type": "raster",
      "source": "satellite",
      "maxzoom": 21,
      "paint": {
        "raster-opacity": 1,
        "raster-fade-duration": 0
      }
    },
    {
      "id": "coastlines",
      "type": "line",
